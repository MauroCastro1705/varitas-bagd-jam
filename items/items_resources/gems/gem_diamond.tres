item_name = "Diamante"
item_description = "El diamante no es solo la piedra preciosa más dura del mundo, sino un símbolo ancestral de invencibilidad y claridad espiritual. En su esencia, el significado del diamante representa la perfección, la iluminación y el triunfo del espíritu sobre la materia."
