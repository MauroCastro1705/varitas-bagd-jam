; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Varitas_por_favor"
run/main_scene="uid://b4m2rdscejd3e"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

TransitionManager="*uid://cbiehau810rdh"
Global="*uid://bp7pndfv3hldx"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://dtm2htbuuaibt"

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg", "res://addons/yard/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://characters/character_resources/": "red",
"res://componentes/": "purple",
"res://escenas/": "green",
"res://fonts/": "yellow",
"res://items/items_resources/": "red",
"res://sandbox/": "red",
"res://ui/": "teal"
}

[global_group]

sockets=""
items=""

[input]

click={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

